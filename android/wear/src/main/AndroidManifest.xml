<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The watch does NOT talk to the relay. Tailscale has no Wear OS client
         (tailscale/tailscale#3972, open since 2022 with no assignee and no
         linked PRs), so the tailnet address is unreachable from here, and the
         funnel deliberately publishes only /answer. Mounting /ask would put
         Claude Code on the public internet. So the watch speaks to the phone
         over the Data Layer and the phone does the network. INTERNET is not
         requested, because nothing here would be allowed to use it.

         Note for anyone editing this comment: XML forbids a double hyphen
         inside a comment, and this project writes prose with one as an ASCII
         dash. That combination is what made the first CI run red. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="PocketClaude"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:label="PocketClaude"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
