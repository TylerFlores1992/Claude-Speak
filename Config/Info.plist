<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>PocketClaude</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Driven by the MARKETING_VERSION / CURRENT_PROJECT_VERSION build
	     settings so `agvtool` (and you, in one place) can bump them. Every
	     TestFlight upload needs a build number nobody has used before. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The relay speaks plain HTTP. iOS blocks cleartext by default, so without
	     this every relay request fails with "App Transport Security policy
	     requires the use of a secure connection".

	     Why this is acceptable here, and why the narrower keys don't work:
	       - The relay is only reachable over Tailscale, which is WireGuard. The
	         traffic is already encrypted at the network layer; adding TLS would
	         mean managing a certificate in order to re-encrypt a tunnel that is
	         already encrypted.
	       - NSAllowsLocalNetworking covers .local, unqualified hostnames, and
	         RFC 1918 addresses. Tailscale hands out 100.64.0.0/10 (CGNAT),
	         which it does not cover.
	       - An NSExceptionDomains entry has to name a specific host, and the
	         address is whatever you type into Settings.

	     This does not weaken HTTPS. The Anthropic and GitHub calls still
	     negotiate TLS normally; this only permits cleartext where the URL asks
	     for it, which in this app is the one relay address you configured. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- Keeps text-to-speech playing with the screen off and the phone pocketed. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Shown verbatim in the iOS permission prompts. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>PocketClaude records your voice while you hold the talk button so it can send your question to Claude.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PocketClaude converts what you say into text. On-device recognition is used when your language supports it.</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
